PROJECT_NAME="AegisMesh API"
VERSION="2.0.0"
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true
DOCS_URL=/docs

# Database configuration
POSTGRES_USER=aegis
POSTGRES_PASSWORD=your_secure_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aegismesh

# Full async DATABASE_URL (optional override)
# DATABASE_URL=postgresql+asyncpg://aegis:your_secure_password@localhost:5433/aegismesh

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication & JWT configuration
JWT_SECRET_KEY=generate_a_secure_random_32_byte_secret_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PUBLIC_REGISTRATION_ENABLED=true

# Open Policy Agent (OPA) configuration
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/v1/data/aegis/decision
